# Copy to .env.local and use absolute paths. This example contains no secrets.
WAW_GAME_DIR=/path/to/Call_of_Duty_World_at_War
PVZ_GAME_DIR=/path/to/Plants_Vs_Zombies
# Directory containing the native WaW mod tools, under this repository's work/.
# tools/waw-tool.sh expects work/modtools/bin/*.exe and prepared tool inputs.
WAW_WINE=/path/to/wine
WAW_WINEPREFIX=/path/to/private/modtools-wine-prefix
# Optional compatibility-runtime wrapper, such as SteamLinuxRuntime_4/run.
WAW_RUNTIME=
# OAT tool binaries, or a wrapper that accepts Linker/Unlinker as argument one.
OAT_BIN_DIR=/path/to/OpenAssetTools
OAT_RUNNER=
# Needed only to install a locally built package. Never point to a game root.
WAW_MODS_DIR=/path/to/CoDWaW/mods
STEAM_BIN=steam
